{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BooruBox",
  "identifier": "me.shirohana.boorubox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "BooruBox",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMjMyOTcwNjQ1QTEzQwpSV1E4b1VVR2x6S2lETXROL3NidHg4b0tEQmI0bzFla29vaitOTUhUQXMvTjdkN25LMlhyc05kNQo=",
      "endpoints": ["https://github.com/shirohana/boorubox/releases/latest/download/latest.json"]
    }
  }
}
